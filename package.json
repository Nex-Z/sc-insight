{
  "name": "sc-insight",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --use-env-proxy --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --use-env-proxy server/index.js",
    "db:init": "node server/init.js",
    "test": "node --test server/*.test.js",
    "test:e2e": "node server/visual-check.js",
    "test:capture": "node --use-env-proxy server/capture-integration.js",
    "test:capture:ui": "node --use-env-proxy server/capture-ui-check.js",
    "test:capture:groups:ui": "node server/capture-groups-ui-check.js",
    "source:check": "node --use-env-proxy server/source-check.js",
    "source:debug": "node --use-env-proxy server/source-debug.js",
    "test:source:http": "node --use-env-proxy server/model-source-integration.js",
    "test:source:ui": "node server/model-recording-ui-check.js",
    "build:release": "npm run build && node scripts/build-release.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "hls.js": "^1.7.3",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "playwright": "^1.58.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.29.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.2",
    "vite": "^7.1.0"
  }
}
